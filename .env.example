APP_NAME="RMC Flow Comércio Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rmc_flow_comercio_cloud_dev
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@rmcsites.com.br"
MAIL_FROM_NAME="${APP_NAME}"

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_ACTIVATE_APPROVED_PAYMENTS=false
MERCADO_PAGO_CHECKOUT_ENABLED=false
MERCADO_PAGO_SANDBOX=true
MERCADO_PAGO_PLAN_CODE=comercio-cloud-essencial
SUBSCRIPTION_PANEL_URL=
SUBSCRIPTION_PANEL_PRODUCT_CODE=rmc-flow-comercio-cloud
SUBSCRIPTION_PANEL_SECRET=
SUPPORT_EMAIL=contato@rmcsites.com.br
SUPPORT_WHATSAPP=
